# ─────────────────────────────────────
# WatchSpace Frontend — Environment Variables
# ─────────────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ─────────────────────────────────────

# Server API base URL (default: http://localhost:3001/api)
VITE_API_URL=http://localhost:3001/api

# WebSocket signaling URL (default: ws://localhost:3001/ws)
VITE_SIGNALING_URL=ws://localhost:3001/ws

# Metered.ca TURN server API key (optional, for NAT traversal)
# Get one from: https://www.metered.ca/
VITE_METERED_API_KEY=
